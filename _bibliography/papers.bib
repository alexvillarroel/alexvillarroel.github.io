@article{Cifuentes-Lobos2023,
author={Cifuentes-Lobos, Rodrigo
and Calisto, Ignacia
and MacInnes, Breanyn
and Moreno, Marcos
and Quezada, Jorge
and San Mart{\'i}n, Javiera
and Fern{\'a}ndez-Palma, Mat{\'i}as
and Saavedra, Cristian},
title={A stochastic approach to the characterization of the seismic sources: a potential method for the assessment of sources of historical and paleo tsunami},
journal={Stochastic Environmental Research and Risk Assessment},
year={2023},
month={Jul},
day={01},
volume={37},
number={7},
pages={2399-2411},
issn={1436-3259},
doi={10.1007/s00477-023-02397-1},
abstract={Inundation, wave arrival and deformation data gathered from measurement campaigns and historical accounts have been used to study past earthquakes and tsunamis, being crucial for magnitude and extension estimations. Nevertheless, the most commonly used methods cannot provide more information about the spatial characteristics of the event’s slip distribution. In this work, we aim to create a methodology for obtaining more realistic, heterogeneous estimations of the slip distribution characteristics of past tsunamigenic earthquakes, by obtaining slip patterns of each earthquake of the same seismic segment, thus establishing a history of the seismic cycle in a rupture zone. To obtain the stochastic characterization of the slip distribution of the seismic source, we combine fault defining parameters using a logic tree structure to generate random slip distributions which are subsequently submitted to successive restrictions to assess their compliance with the available deformation and tsunami data, discarding those that do not satisfy the constraints and using those that do to estimate the most probable seismic source in terms of the data. We test this methodology with synthetic heterogeneous slip fields off the coast of South Central Chile to assess its limitations, data dependence, resolution capabilities and uncertainties. Obtaining a good correlation between the synthetic observations and the locations of the main slip features. Finally, the 9.5 Mw, 1960 Valdivia earthquake is used to benchmark the methodology with real deformation and tsunami data from surveys and historical accounts. This result is then compared to slip distributions obtained with tsunami, seismological and deformation data inversions. This shows that the magnitude of the earthquake could be recovered correctly and the slip distribution is very similar to models calculated from different techniques.
},
url={https://doi.org/10.1007/s00477-023-02397-1},
preview={Stochastic_research.png}
}
@Article{SanMartín2024,
author={San Mart{\'i}n, Javiera
and Calisto, Ignacia
and Quezada, Jorge
and Stewart, Daniel
and Ely, Lisa
and Cifuentes-Lobos, Rodrigo
and Moreno, Marcos},
title={Characterization of historical megathrust earthquake ruptures in Central Chile using logic tree analysis},
journal={Natural Hazards},
year={2024},
month={Apr},
day={01},
volume={120},
number={6},
pages={5411-5427},
abstract={Characterizing the spatial distribution of ruptures from historical and recent earthquakes is key to understanding the seismic cycle of large earthquakes in subduction zones, and thus to assessing the potential risks associated with future earthquakes. Central Chile (35{\$}{\$}^{\{}{\backslash}circ {\}}{\$}{\$}S--38{\$}{\$}^{\{}{\backslash}circ {\}}{\$}{\$}S) has been repeatedly affected by large earthquakes, such as the 2010 Maule (Mw 8.8) and the 1835 earthquakes witnessed by Robert Fitzroy (HMS Beagle captain). Here, we identify the rupture pattern and tsunami propagation of the 1751, 1835, and 2010 mega-earthquakes, events that overlapped in central Chile, by compiling historical records and applying robust statistical tools. We used an adaptation of a logic tree methodology to generate random sources of slip distribution for each event, constrained by tsunami and vertical deformation data. We find that the three events studied have different slip peaks. The 1751 earthquake has the largest slip with a maximum patch of {\$}{\$}{\backslash}sim{\$}{\$}26 m, while the 2010 and 1835 earthquakes reach slips of {\$}{\$}{\backslash}sim{\$}{\$}16 m and {\$}{\$}{\backslash}sim{\$}{\$}10 m, respectively. Our results show that a part of the margin between 36{\$}{\$}^{\{}{\backslash}circ {\}}{\$}{\$}S and 37{\$}{\$}^{\{}{\backslash}circ {\}}{\$}{\$}S was consistently affected by large earthquakes, but with different slip and depth. The shallower depths of the megathrust north of 36{\$}{\$}^{\{}{\backslash}circ {\}}{\$}{\$}S accumulated energy for at least 300 years, which was released by the 2010 earthquake. Our results provide important constraint for rupture patterns and spatial relationships between historical and recent earthquakes, thus extending the time scale for seismic slip distribution analyses over multiple cycles and contributing to a more comprehensive understanding of seismic hazards.},
issn={1573-0840},
doi={10.1007/s11069-024-06404-8},
url={https://doi.org/10.1007/s11069-024-06404-8},
preview={natural.png}
}


@article{PastenAraya2026,
author={Pastén-Araya, Francisco
and Novoa, María Jesus
and Pastene, Rosa
and Villarroel, Alex
and Maksymowicz, Andrei
and Ruiz, Sergio
and Potin, Bertrand
and Peña, Matías},
title={Complex Stress State in the Copiapó Double Seismic Zone, North-Central Chile},
journal={Seismological Research Letters},
publisher={Seismological Society of America},
year={2026},
month={Jul},
issn={1938-2057},
doi={10.1785/0220250424},
url={https://doi.org/10.1785/0220250424},
abstract={The Copiapo segment of north-central Chile, situated within the 1922 megathrust earthquake seismic gap, is characterized by seismic swarms, recurrent slow-slip events, and the subduction of the Copiapo ridge. Although these features have been studied in detail, the internal stress field of the oceanic plate and its relationship with the seismicity distribution and bathymetric structures remain poorly constrained. Using a high-resolution seismic catalog that delineates a well-developed double seismic zone extending from 20 to 120 km depth, we determined focal mechanisms for earthquakes with magnitudes between 2.0 and 4.6, and performed stress inversions to resolve the principal stress directions. Our results reveal complex and distinct depth-dependent stress variations. Near the interplate boundary, compressional stress reflects plate convergence and crustal flexure, with faulting likely modulated by inherited oceanic plate structures. In the upper lithospheric mantle, the stress field exhibits greater heterogeneity. At shallow depths, an extensional regime predominates, controlled by reactivated normal faults. Between 80 and 100 km, we identified a novel subhorizontal compressive stress regime associated with intense seismicity, which we attribute to the subduction of the Copiapo ridge. Alternatively, this compression may result from slab geometry changes marking the transition to the Chilean flat-slab segment. Below 100 km, slab-pull forces re-establish an extensional regime, with seismicity concentrated in the lithospheric mantle and sparse seismicity within the oceanic crust. These findings refine our understanding of the mechanical interplay between intraslab seismicity, subducting bathymetric features, and slab morphology. By providing new constraints on the stress state of the downgoing plate, this study improves the characterization of subduction dynamics and identifies potential nucleation zones for future large-magnitude earthquakes within this mature seismic gap.}
}

@mastersthesis{Villarroel2026,
author={Villarroel Carrasco, Alex},
title={Generación estocástica de terremotos tsunamigénicos y su impacto en la deriva de contenedores en el puerto de Valparaíso},
school={Universidad de Concepción},
type={Master's thesis in Geophysics},
year={2026},
month={Mar},
pdf={https://repositorio.udec.cl/server/api/core/bitstreams/ab928741-1663-42bd-945d-8558f8851b46/content},
abstract={This study aims to develop a framework to generate realistic stochastic slip scenarios by incorporating interseismic coupling as a priori information, along with physical constraints, including rupture boundaries defined by the segmentation of the Chilean subduction margin and the seismogenic zone. The proposed stochastic framework is applied to the Concepción, Valparaíso, and Iquique segments, generating tens of thousands of slip scenarios. Tsunami simulations based on the selected scenarios reproduced observed waveforms at multiple tide gauges, and the ensemble approach effectively quantifies uncertainty in tsunami hazard assessment, complementing deterministic methods and highlighting the influence of interseismic coupling on coseismic slip variability.}
}
